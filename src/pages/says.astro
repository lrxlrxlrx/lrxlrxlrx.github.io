---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import config from "@/config";

const title = "说说";
const description = "扣扣圈和朋友空间";
---

<Layout title={`${title} | ${config.site.title}`} description={description}>
  <Header />

  <Breadcrumb />

  <Main pageTitle={title} pageDesc={description}>
    <div class="mt-6">
      <iframe
        id="memos-frame"
        src="https://memos.luuooo.com/explore"
        title={title}
        class="block h-[78vh] w-full"></iframe>
    </div>
  </Main>

  <Footer />
</Layout>

<script>
  // 与博客主题联动：监听 html[data-theme] 变化，通知 iframe 内的 memos 同步明暗主题
  const MEMOS_ORIGIN = "https://memos.luuooo.com";

  const getIframe = () =>
    document.querySelector<HTMLIFrameElement>("#memos-frame");

  const sendTheme = (theme: "light" | "dark") => {
    const iframe = getIframe();
    if (!iframe?.contentWindow) return;
    iframe.contentWindow.postMessage(
      { source: "astro-blog", type: "theme", theme },
      MEMOS_ORIGIN
    );
  };

  const syncFromHtml = () => {
    const theme = document.documentElement.getAttribute("data-theme");
    if (theme === "dark" || theme === "light") {
      sendTheme(theme);
    }
  };

  const init = () => {
    // 博客切换主题（按钮/系统偏好）都会更新 html[data-theme]，观察它即可
    const observer = new MutationObserver(syncFromHtml);
    observer.observe(document.documentElement, {
      attributes: true,
      attributeFilter: ["data-theme"],
    });

    // iframe 加载完成后立即同步一次，避免初始主题不一致。
    // memos 应用挂载前会丢失过早发出的消息，故在加载后再补发几次
    const syncWithRetry = () => {
      syncFromHtml();
      [1000, 3000, 6000].forEach(delay => setTimeout(syncFromHtml, delay));
    };

    // iframe 每次内部导航（load 事件）都会重新触发同步
    getIframe()?.addEventListener("load", syncWithRetry);

    syncWithRetry();
  };

  init();
  // View Transitions 页面切换后重建监听
  document.addEventListener("astro:page-load", init);
</script>
